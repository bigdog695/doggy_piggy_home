/**index.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 0;
  height: 100vh;
  background-color: #343541;
}

.logo-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 80rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #FFFFFF;
}

.welcome {
  font-size: 34rpx;
  margin-bottom: 100rpx;
  color: #C5C5D2;
}

.userinfo-avatar {
  width: 128rpx;
  height: 128rpx;
  margin: 20rpx;
  border-radius: 50%;
}

.userinfo-nickname {
  color: #C5C5D2;
}

.button-container {
  width: 80%;
  margin-top: 40rpx;
}

.login-btn, .start-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 32rpx;
  margin-bottom: 30rpx;
  border-radius: 8rpx;
}

.login-btn {
  background-color: #10A37F;
  color: #FFFFFF;
  border: none;
}

.start-btn {
  background-color: transparent;
  color: #10A37F;
  border: 1rpx solid #10A37F;
}

.button-hover {
  opacity: 0.8;
} 