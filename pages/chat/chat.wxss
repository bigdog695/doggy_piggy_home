/**chat.wxss**/
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #343541;
  position: relative;
}

/* 头部样式 */
.header {
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  position: relative;
  border-bottom: 1rpx solid #444654;
  background-color: #343541;
}

.header-title {
  font-size: 34rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.clear-button {
  position: absolute;
  right: 30rpx;
  font-size: 26rpx;
  color: #C5C5D2;
}

/* 消息列表样式 */
.message-list {
  flex: 1;
  padding: 20rpx 0;
}

.message {
  display: flex;
  padding: 30rpx 30rpx;
}

.system-message {
  background-color: #444654;
}

.user-message {
  background-color: #343541;
}

.avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 4rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.content {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.6;
  color: #FFFFFF;
  word-break: break-all;
  white-space: pre-wrap;
}

/* 加载动画 */
.loading-container {
  padding: 30rpx;
  display: flex;
  justify-content: center;
}

.loading-dots {
  display: flex;
  align-items: center;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #10A37F;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: loading 1.4s infinite ease-in-out both;
}

.loading-dot:nth-child(1) {
  animation-delay: 0s;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes loading {
  0%, 80%, 100% { 
    transform: scale(0);
  } 
  40% { 
    transform: scale(1.0);
  }
}

/* 输入区域样式 */
.input-container {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #444654;
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #343541;
}

.input-field {
  flex: 1;
  height: 80rpx;
  background-color: #40414F;
  border: none;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  color: #FFFFFF;
}

.send-button {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  margin-left: 20rpx;
  background-color: #40414F;
}

.send-button.active {
  background-color: #10A37F;
}

.send-button image {
  width: 40rpx;
  height: 40rpx;
} 